// Multi-tenant data model. Every tenant-owned table carries an
// organizationId (row-level tenancy). See docs/roadmap.md for which phase
// introduces the UI/logic around each model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (e.g. Neon's PgBouncer endpoint) for the app at runtime.
  url       = env("DATABASE_URL")
  // Unpooled connection, required for migrations. Locally this is the same
  // value as DATABASE_URL; in production it points at Neon's direct endpoint.
  directUrl = env("DIRECT_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
}

// Which product a customer signed up through - SocialPilot and YOPAPI share
// one database/worker, so this is the only thing keeping the two brands'
// customers from being mixed together anywhere admin-facing.
enum OrgBrand {
  SOCIALPILOT
  YOPAPI
}

// DELETED is a soft delete - restorable, since a hard delete would already
// have cascaded away every child row (subscription, jobs, social accounts)
// before an admin could ever "restore" it.
enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  DELETED
}

// Platform-level staff, entirely separate from User/Membership (which are
// customer-side and scoped to a single org). Not a customer concept at all.
enum AdminRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
  FINANCE
}

enum ActivationCodeStatus {
  UNUSED
  REDEEMED
  DISABLED
}

enum SocialProvider {
  INSTAGRAM
  FACEBOOK
}

// Meta has two entirely separate ways to connect an Instagram account: via
// a Facebook Page (the original path - requires the Instagram account to
// have a linked Facebook Page) or directly via "Instagram API with
// Instagram Login" (no Facebook Page needed at all). A FACEBOOK-provider
// row is always FACEBOOK_LOGIN. Which one an INSTAGRAM-provider row used
// determines which Graph API host/token the worker publishes through
// (graph.facebook.com vs graph.instagram.com) - see apps/worker's
// graph-publish.ts.
enum SocialAuthMethod {
  FACEBOOK_LOGIN
  INSTAGRAM_LOGIN
}

enum SocialAccountStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum SubscriptionPlan {
  MONTHLY
  SIX_MONTH
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  // Admin-only manual state, distinct from CANCELED - the client's explicit
  // "pause" action. Never set by the Stripe webhook path.
  PAUSED
}

enum CreativeConceptStatus {
  PENDING
  APPROVED
  REJECTED
}

// Distinguishes a Brand Style concept from a logo concept - both flows
// generate through the same CreativeConcept table, but count toward
// separate monthly caps (see packages/db/src/usage.ts).
enum ConceptKind {
  BRAND_STYLE
  LOGO
}

enum Platform {
  INSTAGRAM
  FACEBOOK
}

enum ContentType {
  POST
  STORY
}

enum ContentPostStatus {
  DRAFT
  QUEUED
  SCHEDULED
  PUBLISHED
  FAILED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// One content job = one scheduled time = one master creative, shared
// identically across every platform selected for that time. Replaces
// ContentPost (kept, unused by new code, as a safety net until the
// deprecation window closes - see packages/db/src/content-post.ts).
enum ContentJobStatus {
  PENDING
  GENERATING
  READY
  PUBLISHING
  PUBLISHED
  FAILED
  RETRYING
  CANCELLED
}

// Lets the materialize/reconcile cycle tell "a recurring slot's occurrence,
// safe to delete/update when the live schedule changes" apart from "a
// customer's explicit one-time post, never touched by reconciliation."
enum ContentJobOrigin {
  SLOT
  ONE_TIME
}

enum ContentPublicationStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
  RETRYING
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String?
  // Bumped to force every outstanding session JWT for this user to fail
  // verification immediately (see apps/web/lib/session.ts) - the only way
  // to revoke a stateless JWT before it naturally expires. Admin's "force
  // logout" action just increments this by one.
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships Membership[]

  @@map("users")
}

model Organization {
  id        String             @id @default(cuid())
  name      String
  brand     OrgBrand           @default(SOCIALPILOT)
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  memberships          Membership[]
  subscription         Subscription?
  brandProfile         BrandProfile?
  brandCreativeProfile BrandCreativeProfile?
  socialAccounts       SocialAccount[]
  creativeConcepts     CreativeConcept[]
  publishingSchedule   PublishingSchedule?
  contentPosts         ContentPost[]
  contentJobs          ContentJob[]

  @@index([brand])
  @@map("organizations")
}

model Membership {
  id             String         @id @default(cuid())
  role           MembershipRole @default(OWNER)
  userId         String
  organizationId String
  createdAt      DateTime       @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  plan                 SubscriptionPlan?
  status               SubscriptionStatus @default(INCOMPLETE)
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model BrandProfile {
  id               String   @id @default(cuid())
  organizationId   String   @unique
  businessName     String
  category         String?
  description      String?
  logoUrl          String?
  colors           Json?
  language         String   @default("en")
  tone             String?
  productsServices Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("brand_profiles")
}

model SocialAccount {
  id                String              @id @default(cuid())
  organizationId    String
  provider          SocialProvider
  externalId        String
  displayName       String?
  profilePictureUrl String?
  accessToken       String
  tokenExpiresAt    DateTime?
  status            SocialAccountStatus @default(ACTIVE)
  authMethod        SocialAuthMethod    @default(FACEBOOK_LOGIN)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([organizationId])
  @@map("social_accounts")
}

model CreativeConcept {
  id             String                @id @default(cuid())
  organizationId String
  brief          String
  imageUrls      String[]
  status         CreativeConceptStatus @default(PENDING)
  kind           ConceptKind           @default(BRAND_STYLE)
  // Set at creation to createdAt + 10h - a PENDING (never approved) concept
  // past this time gets its image deleted and the row removed by
  // apps/worker's cleanup cycle. Never acted on once APPROVED, so an
  // approved Brand Style/logo is never at risk of expiring.
  expiresAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("creative_concepts")
}

model BrandCreativeProfile {
  id                      String   @id @default(cuid())
  organizationId          String   @unique
  styleDescriptors        Json?
  referenceImageUrls      String[]
  palette                 Json?
  promptTemplateAdditions String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("brand_creative_profiles")
}

// What goes out at each scheduled time - the client's explicit per-business
// setting. Captions don't exist on Stories at all (neither Instagram nor
// Facebook Stories carry one), so includeCaption only ever applies to the
// feed post and is moot for STORY_ONLY.
enum PublishMode {
  POST_AND_STORY
  STORY_ONLY
  POST_ONLY
}

model PublishingSchedule {
  id             String      @id @default(cuid())
  organizationId String      @unique
  timezone       String      @default("UTC")
  publishMode    PublishMode @default(POST_AND_STORY)
  includeCaption Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slots        ScheduleSlot[]

  @@map("publishing_schedules")
}

model ScheduleSlot {
  id                   String    @id @default(cuid())
  publishingScheduleId String
  dayOfWeek            DayOfWeek
  /// 24h local time in the schedule's timezone, formatted "HH:mm"
  time                 String
  platform             Platform
  enabled              Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  publishingSchedule PublishingSchedule @relation(fields: [publishingScheduleId], references: [id], onDelete: Cascade)

  @@index([publishingScheduleId])
  @@map("schedule_slots")
}

model ContentPost {
  id             String            @id @default(cuid())
  organizationId String
  platform       Platform
  type           ContentType
  status         ContentPostStatus @default(DRAFT)
  caption        String?
  hashtags       String[]
  imageUrls      String[]
  // Pre-rendered 9:16 version of imageUrls[0], generated once alongside it
  // so the worker can also auto-publish this same post as a Story on the
  // same platform without doing any image processing itself at publish
  // time - just null for STORY-type rows themselves.
  storyImageUrl  String?
  // The resolved creative-variation choices behind this post's image
  // (subject, camera angle/distance, composition, environment, lighting,
  // theme, language) - null for STORY-type rows and reused-image posts
  // that didn't generate fresh. Read back to steer future generations
  // away from repeating the same combination.
  creativeMetadata Json?
  scheduledFor   DateTime?
  publishedAt    DateTime?
  externalPostId String?
  errorMessage   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@map("content_posts")
}

// One row per scheduled publishing time, spanning every platform selected
// for it - the client's explicit fix for Instagram and Facebook sometimes
// ending up with different AI images for what was meant to be one post.
// `platforms` + one `ContentPublication` per platform is what makes "no
// duplicate jobs for the same scheduled time" enforceable: two ScheduleSlot
// rows landing on the same instant (e.g. Monday-18:00-Instagram and
// Monday-18:00-Facebook) collapse into a single job here.
model ContentJob {
  id             String           @id @default(cuid())
  organizationId String
  scheduledFor   DateTime
  platforms      Platform[]
  origin         ContentJobOrigin @default(SLOT)
  status         ContentJobStatus @default(PENDING)
  // Shared across every platform - captions are identical everywhere, not
  // generated per platform, per the client's "publish the same content
  // everywhere" requirement.
  caption        String?
  // The free-text instruction (e.g. "Promote our new chicken meal,
  // highlight the crispy chicken") behind `caption` - a customer edits
  // this, not the caption directly; the caption is regenerated from it
  // plus the brand's profile each time. Null for a job whose caption came
  // from the fully-automatic scheduled pipeline and was never manually
  // instructed.
  captionInstruction String?
  hashtags       String[]
  masterImageUrl String?
  storyImageUrl  String?
  // The resolved creative-variation combination behind masterImageUrl, for
  // steering future generations away from repeating it (see
  // getRecentCreativeMetadata-equivalent in content-job.ts).
  creativeMetadata Json?
  // When the creative was actually generated - distinct from createdAt,
  // which for a slot-materialized job can be up to a week earlier than
  // generation actually happens. Monthly image-usage accounting
  // (packages/db/src/usage.ts) needs the real generation instant, not the
  // row's creation time, to attribute cost to the right calendar month.
  // Left null on a same-day-reused job (no fresh generation happened).
  generatedAt    DateTime?
  // Set once masterImageUrl/storyImageUrl's files were deleted from storage
  // (24 hours after the day's post went out - see findExpiredJobImages).
  // The URLs are deliberately left in place: monthly usage accounting and
  // same-day image reuse read them, and the calendar uses this timestamp
  // to show an "image removed" placeholder instead of a broken image.
  imagesDeletedAt DateTime?
  // Generation attempts only (not publish attempts - those live on
  // ContentPublication, independently per platform).
  attempts       Int              @default(0)
  lastAttemptAt  DateTime?
  errorMessage   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publications ContentPublication[]

  // Enforces "one scheduled time = one job" directly at the database level -
  // the materialize/one-time-post write path upserts against this rather
  // than ever creating a second job for the same instant.
  @@unique([organizationId, scheduledFor])
  @@index([organizationId])
  @@index([status])
  @@map("content_jobs")
}

// One row per (job, platform) - the idempotency and independent-retry unit.
// Instagram succeeding must never be touched again while only Facebook
// retries; a stored externalPostId is the durable proof a platform already
// published, checked before ever calling a Graph API publish endpoint again.
model ContentPublication {
  id              String                    @id @default(cuid())
  contentJobId    String
  platform        Platform
  status          ContentPublicationStatus  @default(PENDING)
  externalPostId  String?
  externalStoryId String?
  attempts        Int                       @default(0)
  lastAttemptAt   DateTime?
  errorMessage    String?
  publishedAt     DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  contentJob ContentJob @relation(fields: [contentJobId], references: [id], onDelete: Cascade)

  @@unique([contentJobId, platform])
  @@index([status])
  @@map("content_publications")
}

// Platform staff, not customers - deliberately its own model rather than a
// role flag on User, so an admin session can never be confused with (or
// forged from) a customer session. See apps/web/lib/admin-session.ts.
model AdminUser {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  name           String?
  role           AdminRole @default(SUPPORT)
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("admin_users")
}

// One row per mutating admin action, for accountability - the client's
// explicit requirement. adminEmail is denormalized so a log entry stays
// meaningful even if the AdminUser row is ever removed later.
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  adminEmail String
  action     String
  targetType String?
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

// Manual, no-payment subscription activation - the client's explicit
// requirement for onboarding early customers paying in cash before Stripe
// is live. redeemActivationCode() (packages/db/src/activation-code.ts)
// redeems one atomically inside a transaction, so it can never be
// double-redeemed under a race.
model ActivationCode {
  id               String               @id @default(cuid())
  code             String               @unique
  plan             SubscriptionPlan
  durationDays     Int
  status           ActivationCodeStatus @default(UNUSED)
  expiresAt        DateTime?
  redeemedByOrgId  String?
  redeemedAt       DateTime?
  createdByAdminId String
  createdAt        DateTime             @default(now())

  @@index([status])
  @@map("activation_codes")
}
