# Copy this file to .env and fill in values. See docker-compose.yml for local
# Postgres/Redis defaults.
#
# Do not set NODE_ENV here: Next.js, Vitest, etc. each set it themselves for
# their own dev/build/test run, and forcing a value here causes it to leak
# into `next build` (which expects to control NODE_ENV=production itself).

# --- Database (Phase 1) ---
# Locally these are the same value. In production (Neon), DATABASE_URL is
# the pooled endpoint and DIRECT_URL is the unpooled one Prisma needs for
# migrations.
DATABASE_URL="postgresql://socialpilot:socialpilot@localhost:5432/socialpilot"
DIRECT_URL="postgresql://socialpilot:socialpilot@localhost:5432/socialpilot"

# --- Queue (used by apps/worker from Phase 9) ---
REDIS_URL="redis://localhost:6379"

# --- Auth (Phase 2) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Billing (Phase 3) ---
# Un-deferred 2026-09-11: the client (not the developer) will hold the
# Stripe account. STRIPE_PRICE_ID_MONTHLY/YEARLY come from Products/Prices
# created in that account (placeholder $49/mo, $470/yr - adjust anytime in
# the Stripe dashboard without a code change).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=

# --- Meta OAuth / Graph API (Phase 5) ---
META_APP_ID=
META_APP_SECRET=

# --- AI (Phase 6+) ---
# Image generation should use gpt-image-1.5 at "medium" quality (user
# preference, given 2026-09-11) once that phase is built.
OPENAI_API_KEY=

# --- Object storage (Phase 4, Cloudflare R2) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=

# --- Secrets (Phase 5, for encrypting stored Meta tokens) ---
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
