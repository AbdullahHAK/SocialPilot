{
  "name": "socialpilot",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "dotenv -e .env -- pnpm --filter web dev",
    "dev:worker": "dotenv -e .env -- pnpm --filter worker dev",
    "build": "dotenv -e .env -- pnpm -r --filter=./apps/* run build",
    "lint": "pnpm -r --filter=./apps/* --filter=./packages/* run lint",
    "typecheck": "pnpm -r --filter=./apps/* --filter=./packages/* run typecheck",
    "test": "dotenv -e .env -- vitest run",
    "test:watch": "dotenv -e .env -- vitest",
    "db:generate": "pnpm --filter @socialpilot/db run generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @socialpilot/db run migrate",
    "db:seed": "dotenv -e .env -- pnpm --filter @socialpilot/db run seed"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv-cli": "^11.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
